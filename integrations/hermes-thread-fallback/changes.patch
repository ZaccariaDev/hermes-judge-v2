+"""Deterministic Discord-thread fallback command (gateway authorization runs upstream)."""
+import asyncio
+
+from agent.fallback_policy import ThreadFallbackPolicy
+
+
+class GatewayFallbackCommandsMixin:
+    async def _handle_fallback_command(self, event):
+        arg = event.get_command_args().strip().lower() or 'status'
+        if arg not in ('off', 'on', 'status'):
+            return 'Usage: /fallback off|on|status'
+        with self._profile_scope_for_source(event.source):
+            policy = ThreadFallbackPolicy.for_source(event.source)
+            if policy is None:
+                return 'Refus : /fallback est réservé à un fil Discord de serveur ; aucune écriture.'
+            if arg != 'status':
+                await asyncio.to_thread(policy.set_enabled, arg == 'on')
+            enabled = await asyncio.to_thread(policy.allowed)
+            key = self._session_key_for_source(event.source)
+            state = self._peek_session_state(key)
+            override = state.conversation.model_override if state else None
+            from hermes_cli.config import read_user_config_raw
+            from gateway.run import _get_channel_override
+            path = policy.home / 'config.yaml'
+            config = await asyncio.to_thread(read_user_config_raw, path) if path.exists() else {}
+            model = config.get('model', {})
+            requested = dict(model) if isinstance(model, dict) else {'model': model}
+            cfg = getattr(self, 'config', None)
+            source = event.source
+            channel = _get_channel_override(
+                cfg, source.platform, str(source.chat_id), thread_id=str(source.thread_id),
+                parent_id=source.parent_chat_id,
+            ) if cfg else None
+            if channel:
+                if channel.model:
+                    requested['model'] = channel.model
+                if channel.provider:
+                    requested['provider'] = channel.provider
+            requested.update({k: v for k, v in (override or {}).items() if v is not None})
+            agent = self._cached_agent_for(key)
+            effective = (f'{agent.provider}/{agent.model}' if agent is not None
+                         else 'inconnue (aucun worker en cache)')
+            route = f"{requested.get('provider') or '?'}/{requested.get('model') or requested.get('default') or '?'}"
+            return (f"Fallback {'on (hérité)' if enabled else 'off'} — fil Discord "
+                    f"{event.source.scope_id}/{event.source.thread_id} uniquement.\n"
+                    f"Route demandée : {route}\nRoute effective : {effective}\n"
+                    'Aucune route modifiée ; appel en cours non interrompu. Les prochaines bascules sont interdites en off. '
+                    'on restaure la politique héritée. Pour sélectionner explicitement : /model <modèle> --provider <fournisseur> --session.')
