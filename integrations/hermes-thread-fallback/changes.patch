+"""Exercise the actual gateway dispatcher and authorization gates with its existing harness."""
+import asyncio
+import importlib.util
+import os
+import tempfile
+import unittest
+from dataclasses import replace
+from pathlib import Path
+from unittest.mock import patch
+
+import gateway
+from gateway.config import GatewayConfig, Platform, PlatformConfig
+from gateway.platforms.event import MessageEvent
+from gateway.session import SessionSource
+from agent.fallback_policy import ThreadFallbackPolicy
+
+
+class DispatcherTests(unittest.TestCase):
+    def test_authorized_idle_busy_denied_and_two_thread_isolation(self):
+        runtime = Path(gateway.__file__).parent.parent
+        fixture = runtime / 'tests/gateway/test_gateway_command_dispatch_minimal.py'
+        spec = importlib.util.spec_from_file_location('minimal_gateway_dispatch_fixture', fixture)
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        runner, adapter = module._make_runner()
+        from gateway.run_busy import GatewayBusySessionMixin
+        runner._check_slash_access = GatewayBusySessionMixin._check_slash_access.__get__(runner)
+        runner.config = GatewayConfig(platforms={Platform.DISCORD:PlatformConfig(enabled=True, extra={
+            'group_allow_admin_from':['alice'], 'group_user_allowed_commands':[]})})
+        runner.adapters = {Platform.DISCORD:adapter}
+        runner._cached_agent_for = lambda key: None
+        source = SessionSource(Platform.DISCORD,'a',chat_type='thread',thread_id='a',scope_id='guild',user_id='alice')
+        with tempfile.TemporaryDirectory() as home, patch.dict(os.environ,HERMES_HOME=home):
+            async def send(arg, src=source):
+                return await runner._handle_message(MessageEvent(text='/fallback '+arg, source=src, internal=True))
+            text = asyncio.run(send('off'))
+            self.assertIn('off',text)
+            self.assertFalse(ThreadFallbackPolicy.for_source(source).allowed())
+            self.assertTrue(ThreadFallbackPolicy.for_source(replace(source,thread_id='b')).allowed())
+            denied = asyncio.run(send('on',replace(source,user_id='bob')))
+            self.assertIn('admin-only',denied)
+            self.assertFalse(ThreadFallbackPolicy.for_source(source).allowed())
+            # In-flight worker: same dispatcher, no interruption and no LLM call.
+            key = runner._session_key_for_source(source)
+            worker = module.MagicMock()
+            runner._running_agents[key] = worker
+            text = asyncio.run(send('on'))
+            self.assertIn('on (hérité)',text)
+            worker.interrupt.assert_not_called()
+            self.assertTrue(ThreadFallbackPolicy.for_source(source).allowed())
+            self.assertFalse(adapter._pending_messages)
+
+
+if __name__ == '__main__':
+    unittest.main()
