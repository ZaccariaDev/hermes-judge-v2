+_current_policy = ContextVar('thread_fallback_policy', default=None)
+
+
+@dataclass(frozen=True)
+class ThreadFallbackPolicy:
+    home: Path
+    key: str
+
+    @classmethod
+    def for_source(cls, source):
+        platform = getattr(getattr(source, 'platform', None), 'value', None)
+        thread = getattr(source, 'thread_id', None)
+        scope = getattr(source, 'scope_id', None) or getattr(source, 'guild_id', None)
+        if platform != 'discord' or not thread or not scope or source.chat_type == 'dm':
+            return None
+        identity = json.dumps([platform, str(scope), str(thread)], separators=(',', ':'))
+        return cls(Path(get_hermes_home()), 'thread_fallback:v1:' + identity)
+
+    def allowed(self):
+        path = self.home / 'state.db'
+        if not path.exists():
+            return True
+        from hermes_state import SessionDB
+        with closing(SessionDB(path, read_only=True)) as db:
+            return db.get_meta(self.key) != 'off'
+
+    def set_enabled(self, enabled):
+        from hermes_state import SessionDB
+        with closing(SessionDB(self.home / 'state.db')) as db:
+            db.set_meta(self.key, 'inherit' if enabled else 'off')
+
+
+def fallback_allowed(agent=None):
+    policy = getattr(agent, '_thread_fallback_policy', None) if agent is not None else None
+    policy = policy or _current_policy.get()
+    return policy is None or policy.allowed()
+
+
+@contextmanager
+def thread_fallback_scope(source):
+    token = _current_policy.set(ThreadFallbackPolicy.for_source(source))
+    try:
+        yield
+    finally:
+        _current_policy.reset(token)
